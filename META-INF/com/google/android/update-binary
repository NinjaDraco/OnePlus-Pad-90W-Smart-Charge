#!/sbin/sh
#################
# Magisk Module #
#################
exec /data/adb/magisk/busybox ash -c '
OUTFD=$2
ZIPFILE="$3"
if [ -f /data/adb/magisk/util_functions.sh ]; then
    . /data/adb/magisk/util_functions.sh
    install_module
elif [ -f /data/adb/ksu/util_functions.sh ]; then
    . /data/adb/ksu/util_functions.sh
    install_module
else
    echo "! Magisk / KernelSU / APatch not detected"
    exit 1
fi
'
