#!/sbin/sh
#################
# Magisk Module #
#################
if [ -x /data/adb/magisk/busybox ] && [ -z "$_BB_WRAPPED" ]; then
    export _BB_WRAPPED=1
    exec /data/adb/magisk/busybox ash "$0" "$@"
fi
OUTFD=$2
ZIPFILE="$3"
if [ -f /data/adb/magisk/util_functions.sh ]; then
    . /data/adb/magisk/util_functions.sh
    install_module
elif [ -f /data/adb/ksu/util_functions.sh ]; then
    . /data/adb/ksu/util_functions.sh
    install_module
else
    echo "! Magisk / KernelSU / APatch not detected"
    exit 1
fi
